#!/usr/bin/env bash
# thin dispatcher: archive <ingest|query|serve> ...
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cmd="$1"; shift || true
case "$cmd" in
  ingest) exec python3 "$here/archive/ingest_batch.py" "$@" ;;
  query)  exec python3 "$here/archive/query.py" "$@" ;;
  serve)  exec python3 "$here/archive/serve.py" "$@" ;;
  surface) exec python3 "$here/archive/surface.py" "$@" ;;
  act)    exec python3 "$here/archive/actlog.py" "$@" ;;
  points) exec python3 "$here/archive/points.py" points "$@" ;;
  project) exec python3 "$here/archive/points.py" project "$@" ;;
  *) echo "usage: archive <ingest|query|serve|surface|act|points|project> ..."; exit 1 ;;
esac
