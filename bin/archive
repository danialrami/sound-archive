#!/usr/bin/env bash
# compat alias — `archive` is the legacy entrypoint; it now delegates to the canonical
# `larc` dispatcher so existing scripts (README, setup.sh, cron) keep working unchanged.
# All subcommand dispatch lives in bin/larc.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "$here/larc" "$@"
